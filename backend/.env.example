# ============================================================================
#  ToroGo - Plantilla de variables de entorno (SI se sube a Git)
#
#  Para un companero nuevo en el equipo:
#    1) copia este archivo como .env
#    2) cambia las claves de abajo
#    3) docker compose up -d app nginx postgres redis minio mailpit
# ============================================================================

# ---------------------------------------------------------------- Aplicacion
APP_NAME=ToroGo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/El_Salvador

APP_LOCALE=es_SV
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_SV

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------- Puertos expuestos al host
APP_PORT=8080
VITE_PORT=5173
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# ------------------------------------------------------------- Base de datos
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=torogo
DB_USERNAME=torogo
DB_PASSWORD=cambia_esta_clave

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# ------------------------------------------------------------- Autenticacion
# Minutos de vida de los tokens de la API movil. 10080 = 7 dias.
SANCTUM_EXPIRATION=10080

# --------------------------------------------------------------------- Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ------------------------------------------------------- Archivos / MinIO
# Disco S3 apuntando a MinIO. Requiere que el bucket exista
# (consola MinIO: http://localhost:9001) y el paquete league/flysystem-aws-s3-v3.
# AWS_ENDPOINT = como lo ve el contenedor app | AWS_URL = como lo ve el navegador
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=torogo
AWS_SECRET_ACCESS_KEY=cambia_esta_clave
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=torogo
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/torogo
AWS_USE_PATH_STYLE_ENDPOINT=true

# -------------------------------------------------------- MinIO (contenedor)
MINIO_ROOT_USER=torogo
MINIO_ROOT_PASSWORD=cambia_esta_clave

# ------------------------------------------------------- Correo (Mailpit)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@torogo.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------- Tiempo real (Reverb)
# Las llaves NO se escriben a mano: las genera
#   php artisan install:broadcasting --reverb --without-node
# (una APP_ID, una KEY y un SECRET al azar por instalacion).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# OJO, IGUAL QUE DB_HOST: "reverb" es el NOMBRE DEL SERVICIO en docker-compose,
# no localhost. Es como el contenedor "app" encuentra al contenedor "reverb"
# para publicarle los eventos.
REVERB_HOST=reverb

# Puerto INTERNO del contenedor reverb. Al navegador y al telefono les llega
# por el 8081 (ver docker-compose.yml).
REVERB_PORT=8080
REVERB_SCHEME=http

# Donde ESCUCHA Reverb, adentro del contenedor.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Cliente JavaScript (laravel-echo). La app movil es Flutter y no las usa.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
