<?xml version="1.0" encoding="utf-8"?>
<!-- Splash de arranque: petroleo de la marca con el simbolo al centro.

     Android lo muestra mientras Flutter arranca y lo quita solo en el primer
     frame. El simbolo es un vector, asi que se ve nitido en cualquier
     pantalla sin guardar un PNG por densidad. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/torogo_icon_background" />

    <item
        android:gravity="center"
        android:drawable="@drawable/splash_symbol" />
</layer-list>
