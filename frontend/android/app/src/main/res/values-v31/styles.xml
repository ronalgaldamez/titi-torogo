<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 en adelante dibuja su propio splash e ignora el
         windowBackground del tema base. Estos dos valores lo alinean con la
         marca: fondo petroleo y el mismo simbolo del icono. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/torogo_icon_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_symbol</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
